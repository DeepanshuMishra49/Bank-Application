# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# Add .env to .gitignore so secrets are never committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Mail (Gmail App Password — NOT your normal Gmail password) ────────────────
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BANKING_REMEMBER_ME_KEY=replace_with_strong_random_secret_at_least_32_chars

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
